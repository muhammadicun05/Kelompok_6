# ==========================================
# LUKLA RAG SERVICE — CONFIGURATION (.env.example)
# Pure Manual RAG (Titan us-east-1 + Nova Lite ap-southeast-1 + Supabase pgvector)
# ==========================================

# AWS Credentials (student_6)
AWS_ACCESS_KEY=your_aws_access_key_here
AWS_SECRET_ACCESS=your_aws_secret_key_here

# Cross-Region AWS Bedrock Configuration
# 1. Embedding Model: Amazon Titan Text Embeddings V2 (Region: us-east-1)
BEDROCK_EMBEDDING_REGION=us-east-1
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# 2. LLM Generation Model: Amazon Nova Lite (Region: ap-southeast-1)
BEDROCK_LLM_REGION=ap-southeast-1
BEDROCK_LLM_MODEL_ID=amazon.nova-lite-v1:0

# S3 Knowledge Bucket (Optional / Backup)
AWS_BUCKET=lukla-knowledge-bucket

# Supabase Vector Store (Kelompok_6)
SUPABASE_URL=https://wrugjojtvgkuwjqopete.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
